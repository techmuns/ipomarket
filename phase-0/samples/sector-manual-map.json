      "industry": "string — e.g. 'Petroleum Products'",
      "basicIndustry": "string — e.g. 'Refineries & Marketing'",
      "_source": "string — 'rhp-cover' | 'manual' | 'nse-post-listing'"
    }
  },
  "_lookup_key_format": "Use NSE/BSE listing symbol if already assigned; otherwise the normalized company name (lowercase, no spaces, no 'limited').",
