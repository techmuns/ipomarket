node_modules/
*.log
# Exception: keep build/preview logs from the visual-QA workflow so they
# commit alongside the screenshots for offline diagnosis.
!phase-1-screens/*.log
.env
.env.local
.DS_Store
.python-cache/
__pycache__/
*.pyc
.venv/
venv/

# Vite build output
dist/

# Phase 0 large/binary samples are excluded from the repo;
# only structured JSON/HTML excerpts and metadata are committed.
phase-0/samples/*.pdf
phase-0/samples/*.full.html

# Local probe scratch
phase-0/.scratch/

# Phase 5A PDF parser — downloaded PDF binaries + full text dumps are
# NEVER committed (per master plan §V.7 item 11). Only the per-IPO
# extraction JSON (cover.json / financials.json), the index summary, and
# the bounded raw_snippet rows in src/data/snapshots/ipo-pdf-extraction-audit.json
# land in git.
phase-0/pdf-extracts/**/*.pdf
phase-0/pdf-extracts/**/source.pdf
phase-0/pdf-extracts/**/*.txt
phase-0/pdf-extracts/**/pagecount.json
